{
  "name": "workflow-orchestrator",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest unit",
    "test:integration": "jest int",
    "test:e2e": "jest e2e",
    "dev": "ts-node-dev --respawn -r tsconfig-paths/register --poll src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typeorm": "ts-node --transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "pnpm run typeorm migration:generate",
    "migration:create": "pnpm run typeorm migration:create",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "typeorm:prod": "node ./node_modules/typeorm/cli.js -d dist/src/database/data-source.js",
    "start:prod": "pnpm migration:run && pnpm start"
  },
  "dependencies": {
    "@core/main": "workspace:*",
    "@platform/logger": "workspace:*",
    "@platform/queue-rabbitmq": "workspace:*",
    "@platform/tracing": "workspace:*",
    "dotenv": "^17.2.3",
    "p-limit": "^7.3.0",
    "pg": "^8.18.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.13",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "testcontainers": "^11.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.14.0"
}
